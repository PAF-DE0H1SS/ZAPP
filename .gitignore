# Сборка
build/
*/build/
.gradle/
local.properties

# Тестовый APK собирается локально и весит >100 МБ -- GitHub такие файлы
# не принимает, а хранить бинари в истории нельзя. Образы раздаёт CI
# (см. .github/workflows/build.yml), не репозиторий.
zapp-test.apk

# Подпись APK: keystore и пароли не в репозитории
signing/
*.jks
*.keystore

# Нативные бинари и сырьё: клоны upstream-репозиториев, тарболлы, сборка.
# В git идут только скрипты и патчи (build*.sh, pack.sh, patches/).
native/out/
native/src/

# Библиотеки для APK: кладёт pack.sh из native/out (300M)
APP/app/src/main/jniLibs/

# Служебное окружение
.idea/
ldpath
AGENTS.md
AGENTS.md.bak-*
JOURNAL.md

# Локальные сборочные скрипты: в репозиторий не идут, build-all.sh зовёт их с диска
scripts/

# Локальные тесты на устройстве: скрипты, скриншоты, логи
.devtest/
TODO.md

# Симлинк-сам на себя, локальная особенность каталога
ZAPP
