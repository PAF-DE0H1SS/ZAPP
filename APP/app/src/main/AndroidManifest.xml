<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Сеть: без INTERNET приложение не может ни обновить источники, ни
        проверить коннекты, ни поднять туннель: сокеты блокируются на
        уровне системы ещё до каких-либо ошибок приложения. Состояние сети
        нужно, чтобы честно показывать «нет связи», а не крутить проверку
        вхолостую.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Короткий отклик на смену состояния туннеля (UX3). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Старт после перезагрузки (§137): только при включённом тумблере
        «Старт при загрузке устройства» и хотя бы одном флаге автостарта
        (см. BootAutostart). Разрешение normal — выдаётся молча.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Foreground-сервис: туннель держится вне зависимости от того, свёрнуто
        ли приложение, а системный значок VPN остаётся видимым. Тип
        specialUse для сервиса, который не попадает в штатные категории
        (сеть/медиа); подтверждение типа объявляется свойством сервиса ниже.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        Точное местоположение: точность нужна тест-провайдеру, координаты
        которого подменяют собой системные. ACCESS_MOCK_LOCATION объявлен
        осознанно: без него приложение вообще не попадает в список
        «Приложение для имитации местоположения» в настройках разработчика.
        Само разрешение выдаётся не диалогом, а выбором в этих настройках,
        поэтому runtime-диалог запрашивается только для гео.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- С 12-го Android вместе с FINE обязано быть объявлено и COARSE:
         пользователь может выдать только точное или только грубое,
         и приложение должно работать в обоих случаях. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />

    <!--
        Уведомления: события подмены и обновления. Это runtime-разрешение
        (Android 13+), спрашивается диалогом, поэтому запрос живёт в
        настройках и не навязывается при старте.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Список установленных приложений для per-app выбора. С Android 11
        package visibility отдаёт приложению только видимые пакеты, без
        этого разрешения каталог был бы усечён до системных и нескольких
        «желательных», а пользователь должен видеть ВСЕ свои приложения,
        чтобы выбрать, что идёт через VPN, а что мимо. Разрешение normal:
        выдаётся молча при установке.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".ZappApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZAPP">
        <!--
            Единственная Activity сама LAUNCHER-фильтра не держит: точка
            входа — два activity-alias с разными иконками. Логика проста —
            подключено -> unlock, всё остальное -> lock; переключение
            делает LauncherIcon. Если лаунчер не умеет подменять иконку,
            остаётся enabled-alias, а основная иконка приложения — unlock.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- Deep-link zapp://import?url=... и zapp://connect?profile=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="zapp"
                    android:host="import" />
                <data
                    android:scheme="zapp"
                    android:host="connect" />
            </intent-filter>
        </activity>

        <!-- Виджет рабочего стола: статус VPN и быстрое переключение. -->
        <receiver
            android:name=".widget.VpnWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vpn_widget_info" />
        </receiver>

        <activity-alias
            android:name=".LauncherLock"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lock"
            android:roundIcon="@mipmap/ic_launcher_round_lock"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherUnlock"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_unlock"
            android:roundIcon="@mipmap/ic_launcher_round_unlock"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            VPN-туннель. BIND_VPN_SERVICE держит привязку у системы:
            приложение не может поднять туннель само по своей воле,
            только через службу с этим разрешением. Экспорт намеренный,
            системный VPN-менеджер должен уметь службу найти; вся защита
            от посторонних вызовов в самом разрешении (подпись системы).
        -->
        <service
            android:name="xyz.azraellab.zapp.core.engine.ZappVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_vpn_tunnel" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            Служба подмены координат: цикл живёт вне Activity, а шторка
            показывает текущую точку и кнопку СТОП. Старт — только из
            приложения, от посторонних вызовов закрыт exported=false.
        -->
        <service
            android:name="xyz.azraellab.zapp.core.gps.ZappGpsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="mock_location_spoofing" />
        </service>

        <!--
            Старт из перезагрузки (§137). exported=true — единственный
            способ получить системную рассылку BOOT_COMPLETED, и он
            безопасен: действие объявлено protected broadcast, прислать
            его может только система, подделать из другого приложения —
            SecurityException.
        -->
        <receiver
            android:name=".BootAutostart"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Плитки быстрого доступа (шторка уведомлений). Три отдельных
            сервиса одного класса: подпись берётся из android:label, а
            поведение берётся из подкласса. ACTIVE_TILE обязывает систему
            переспрашивать состояние при каждом раскрытии шторки, поэтому
            плитка не врёт после смены статуса из приложения.
            BIND_QUICK_SETTINGS_TILE выдаётся только системе.
        -->
        <service
            android:name=".tile.TileVpn"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tile.TileTor"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Tor"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tile.TileZapret"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Zapret"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Отдача закешированного APK обновления установщику: прямой
             file:// на Android 7+ роняет установку с FileUriExposedException. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>